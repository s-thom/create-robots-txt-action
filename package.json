{
  "name": "create-robots-txt-action",
  "description": "An action to generate a robots.txt file",
  "version": "2.0.0",
  "author": "",
  "private": true,
  "homepage": "https://github.com/s-thom/create-robots-txt-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-thom/create-robots-txt-action.git"
  },
  "bugs": {
    "url": "https://github.com/s-thom/create-robots-txt-action/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "npx vitest",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx local-action . src/main.ts .env",
    "package": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=node",
    "test": "npx vitest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "cloudflare": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@github/local-action": "^7.0.1",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
